# VPS only. Vercel should use Project Settings -> Environment Variables.
HOST=0.0.0.0
PORT=3000

# VPS SQLite database path. Leave empty to use ./data/mail.db.
DATA_DIR=./data
# DB_PATH=./data/mail.db

# Optional API password. When set, protected APIs must include password.
PASSWORD=your-password

# Optional send-mail password. When set, /api/send-mail must include send_password.
SEND_PASSWORD=your-send-password

# Optional OpenAI-compatible AI proxy config for /api/ai.
AI_API_KEY=your-api-key
AI_API_URL=https://api.example.com
AI_MODEL=your-model-name
